# Copy to .env. Use credentials from the same LaunchDarkly project and environment.
LAUNCHDARKLY_CLIENT_SIDE_ID=
LD_SDK_KEY=

# Optional: protect a hosted chat when you add a billable provider key.
DEMO_PASSCODE=

# Optional: live AgentControl/OpenAI replies. Without a key, replies are labeled canned.
OPENAI_API_KEY=
LAUNCHDARKLY_AI_CONFIG_KEY=support-chat-assistant

# Optional: Generic trigger URL for npm run kill-switch.
LAUNCHDARKLY_TRIGGER_URL=

# Optional local port. The host-provided PORT takes precedence.
PORT=3000
