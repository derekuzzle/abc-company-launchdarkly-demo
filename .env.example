# Public client-side ID and private server SDK key from the SAME LaunchDarkly environment.
# The server SDK key is required to authorize every chat request, not just live AI.
LAUNCHDARKLY_CLIENT_SIDE_ID=
LD_SDK_KEY=

# Exact browser origin, no trailing slash. Set to the Preview origin in managed dev,
# your HTTPS published origin in production, or localhost for a local run.
APP_PUBLIC_ORIGIN=http://localhost:3000

# Comma-separated Manus account emails allowed to use the chat endpoint.
# Demo sample contexts are for flag targeting only and do not grant access.
CHAT_ALLOWED_EMAILS=

# Generate once with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Use a different secret per environment and keep it out of Git.
APP_SESSION_SECRET=

# Optional: set to true and restart to block new chat requests even if the
# LaunchDarkly SDK still has a cached On value during a connectivity outage.
CHAT_EMERGENCY_OFF=false

# Optional if your plan permits a Generic trigger on release-support-chat.
# This secret URL is used by npm run kill-switch, not by the website.
LAUNCHDARKLY_TRIGGER_URL=

# Optional provider key for live AI replies. Without it, chat returns a labeled canned
# response, but only after login and a successful server-side On flag evaluation.
OPENAI_API_KEY=

# Completion/messages-mode AgentControl config key created in LaunchDarkly.
LAUNCHDARKLY_AI_CONFIG_KEY=support-chat-assistant

# Optional local HTTP port, defaults to 3000. A host-provided PORT takes precedence.
PORT=3000
