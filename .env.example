# Public environment identifier from LaunchDarkly Project settings > Environments.
LAUNCHDARKLY_CLIENT_SIDE_ID=

# Private server SDK key from LaunchDarkly Settings > SDK keys for the SAME environment.
LD_SDK_KEY=

# Only if your account permits a Generic trigger on release-support-chat.
# Keep this unguessable webhook URL private.
LAUNCHDARKLY_TRIGGER_URL=

# OpenAI API key for live AI replies. Blank uses labeled canned responses.
OPENAI_API_KEY=

# The completion/messages-mode AgentControl config key created in LaunchDarkly.
LAUNCHDARKLY_AI_CONFIG_KEY=support-chat-assistant

# Optional local HTTP port, defaults to 3000.
PORT=3000
